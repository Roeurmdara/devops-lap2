apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: react-app-gitops
  namespace: {{ argocd_namespace | default('argocd') }}
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: {{ gitops_repo_url | default('https://github.com/keoKAY/devoops12-shortcourse-weekend.git') }}
    targetRevision: {{ gitops_repo_target_revision | default('HEAD') }}
    path: {{ gitops_repo_path | default('7.kubernetes/ingress') }}
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ react_namespace | default('production') }}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
