apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: headlamp
  namespace: {{ headlamp_namespace | default('headlamp') }}
  annotations:
    cert-manager.io/cluster-issuer: {{ cluster_issuer_name | default('letsencrypt-prod') }}
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
spec:
  ingressClassName: traefik
  tls:
    - hosts:
        - {{ headlamp_domain | default('headlamp.dara.lifestyle') }}
      secretName: headlamp-tls-cert
  rules:
    - host: {{ headlamp_domain | default('headlamp.dara.lifestyle') }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: headlamp
                port:
                  number: 80
