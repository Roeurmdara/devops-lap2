apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ headlamp_service_account | default('headlamp-admin') }}
  namespace: {{ headlamp_namespace | default('headlamp') }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ headlamp_service_account | default('headlamp-admin') }}
subjects:
  - kind: ServiceAccount
    name: {{ headlamp_service_account | default('headlamp-admin') }}
    namespace: {{ headlamp_namespace | default('headlamp') }}
roleRef:
  kind: ClusterRole
  name: cluster-admin
  apiGroup: rbac.authorization.k8s.io
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ headlamp_service_account | default('headlamp-admin') }}-token
  namespace: {{ headlamp_namespace | default('headlamp') }}
  annotations:
    kubernetes.io/service-account.name: {{ headlamp_service_account | default('headlamp-admin') }}
type: kubernetes.io/service-account-token
